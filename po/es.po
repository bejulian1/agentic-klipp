#. Keep the command name, flags and mode values unchanged.
#: src/cli.rs:8
msgid ""
"Agentic Klipp: skjermbilder til AI-kodeagenter\n"
"\n"
"Bruk:\n"
"  klipp                  Vis vinduet (starter appen om den ikke kjører)\n"
"  klipp --capture        Ta et skjermbilde med sist brukte modus\n"
"  klipp --capture --mode omrade|frihand|vindu|skjerm\n"
"  klipp --hidden         Start skjult, for autostart\n"
"  klipp --quit           Avslutt appen\n"
"  klipp --version        Vis versjonen\n"
"  klipp --help           Vis denne hjelpen\n"
msgstr ""
"Agentic Klipp: capturas de pantalla para agentes de IA que programan\n"
"\n"
"Uso:\n"
"  klipp                  Muestra la ventana (inicia la aplicación si hace falta)\n"
"  klipp --capture        Hace una captura de pantalla con el último modo usado\n"
"  klipp --capture --mode omrade|frihand|vindu|skjerm\n"
"  klipp --hidden         Inicia la aplicación oculta al iniciar sesión\n"
"  klipp --quit           Cierra la aplicación\n"
"  klipp --version        Muestra la versión\n"
"  klipp --help           Muestra esta ayuda\n"

