#. Keep the command name, flags and mode values unchanged.
#: src/cli.rs:8
msgid ""
"Agentic Klipp: skjermbilder til AI-kodeagenter\n"
"\n"
"Bruk:\n"
"  klipp                  Vis vinduet (starter appen om den ikke kjører)\n"
"  klipp --capture        Ta et skjermbilde med sist brukte modus\n"
"  klipp --capture --mode omrade|frihand|vindu|skjerm\n"
"  klipp --hidden         Start skjult, for autostart\n"
"  klipp --quit           Avslutt appen\n"
"  klipp --version        Vis versjonen\n"
"  klipp --help           Vis denne hjelpen\n"
msgstr ""
"Agentic Klipp: skärmbilder för AI-kodagenter\n"
"\n"
"Användning:\n"
"  klipp                  Visa fönstret (startar appen om den inte körs)\n"
"  klipp --capture        Ta en skärmbild med senast använda läge\n"
"  klipp --capture --mode omrade|frihand|vindu|skjerm\n"
"  klipp --hidden         Starta dold vid inloggning\n"
"  klipp --quit           Avsluta appen\n"
"  klipp --version        Visa versionen\n"
"  klipp --help           Visa den här hjälpen\n"

